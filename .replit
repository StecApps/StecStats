modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.build]
# Run the secrets check before building. If any required secret is missing the
# script exits 1 and the deploy is aborted before serving any traffic.
args = ["bash", "-c", "bash scripts/check-production-secrets.sh && pnpm run build"]
env = { "CI" = "true" }

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

