{
  "expo": {
    "name": "StecStats",
    "slug": "hoops-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hoopsstats",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A09"
    },
    "ios": {
      "bundleIdentifier": "com.hoopsstats.coach",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "StecStats uses your camera to record game footage during basketball games. Recorded video is saved to your account and used to generate highlight reels and support film review after the game.",
        "NSMicrophoneUsageDescription": "StecStats uses your microphone to capture audio during game recordings. Audio is included in your saved game footage and highlight clips.",
        "LSApplicationQueriesSchemes": [
          "itms-apps",
          "itms-apps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "20260809"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0C0A09"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.hoopsstats.coach"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "StecStats uses your camera to record game footage during basketball games. Recorded video is saved to your account and used to generate highlight reels and support film review after the game.",
          "microphonePermission": "StecStats uses your microphone to capture audio during game recordings. Audio is included in your saved game footage and highlight clips.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StecStats uses your photo library to let you set profile photos for players on your roster. Selected photos are uploaded to your account and shown on player profile pages."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "./plugins/withSwiftConcurrencyFix",
      "@clerk/expo",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0C0A09",
          "sounds": [],
          "androidMode": "default"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/2115ac2f-b1d6-42f5-a109-9dd376d0121a",
      "enabled": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "2115ac2f-b1d6-42f5-a109-9dd376d0121a"
      }
    },
    "owner": "sstec"
  }
}
