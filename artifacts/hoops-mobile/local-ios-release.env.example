# Copy this file to .env.local before creating a local Xcode release build.
# .env.local is ignored by Git and must not be committed.

APP_ENV=production
EXPO_PUBLIC_DOMAIN=stecstats.com

# Obtain the Production publishable key for the same Replit-managed Clerk
# tenant shown under Users & Auth. The release check confirms that it begins
# with pk_live_ and encodes clerk.stecstats.stecco.org.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PROXY_URL=https://stecstats.com/api/__clerk

# RevenueCat public iOS SDK key. This is already used by the production app.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_TTSbkcTluVOVtQXJqgLnFCOMFCe