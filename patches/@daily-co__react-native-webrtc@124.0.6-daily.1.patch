+RCT_REMAP_METHOD(setCameraZoom,
+                 setCameraZoom:(nonnull NSString *)trackID
+                 normalizedZoom:(nonnull NSNumber *)normalizedZoom
+                 resolver:(RCTPromiseResolveBlock)resolve
+                 rejecter:(RCTPromiseRejectBlock)reject) {
+#if TARGET_OS_TV
+    reject(@"unsupported_platform", @"Camera zoom is not supported on tvOS", nil);
+#else
+    RTCMediaStreamTrack *track = self.localTracks[trackID];
+    if (![track isKindOfClass:[RTCVideoTrack class]]) {
+        reject(@"camera_zoom_track_missing", @"Local camera track was not found", nil);
+        return;
+    }
+    RTCVideoTrack *videoTrack = (RTCVideoTrack *)track;
+    if (![videoTrack.captureController isKindOfClass:[VideoCaptureController class]]) {
+        reject(@"camera_zoom_unavailable", @"The active video track is not a camera", nil);
+        return;
+    }
+    NSError *error = nil;
+    CGFloat appliedFactor = [(VideoCaptureController *)videoTrack.captureController
+        setNormalizedZoom:normalizedZoom.doubleValue
+                    error:&error];
+    if (error) {
+        reject(@"camera_zoom_failed", error.localizedDescription, error);
+        return;
+    }
+    resolve(@(appliedFactor));
+#endif
+}
+
 @end
