diff --git a/ios/RCTWebRTC/VideoCaptureController.m b/ios/RCTWebRTC/VideoCaptureController.m
index 532276a2aedc6be5d2fcfc1476d952ef24d6a7a2..3e8e0d1fd7bce86f7f8cc714bb32b1d45b08ef9f 100644
--- a/ios/RCTWebRTC/VideoCaptureController.m
+++ b/ios/RCTWebRTC/VideoCaptureController.m
@@ -198,6 +198,34 @@
     return self.usingFrontCamera ? @"user" : @"environment";
 }
 
+- (CGFloat)setNormalizedZoom:(CGFloat)normalizedZoom error:(NSError **)outError {
+    AVCaptureDevice *device = self.device;
+    if (!device) {
+        if (outError) {
+            *outError = [NSError errorWithDomain:@"WebRTCModule"
+                                            code:1
+                                        userInfo:@{NSLocalizedDescriptionKey : @"Camera is not active"}];
+        }
+        return 1.0;
+    }
+
+    CGFloat boundedZoom = MIN(1.0, MAX(0.0, normalizedZoom));
+    CGFloat minimumFactor = 1.0;
+    CGFloat maximumFactor = MIN(5.0, device.activeFormat.videoMaxZoomFactor);
+    CGFloat requestedFactor = minimumFactor + boundedZoom * (maximumFactor - minimumFactor);
+    NSError *configurationError = nil;
+    if (![device lockForConfiguration:&configurationError]) {
+        if (outError) {
+            *outError = configurationError;
+        }
+        return device.videoZoomFactor;
+    }
+    device.videoZoomFactor = MIN(maximumFactor, MAX(minimumFactor, requestedFactor));
+    CGFloat appliedFactor = device.videoZoomFactor;
+    [device unlockForConfiguration];
+    return appliedFactor;
+}
